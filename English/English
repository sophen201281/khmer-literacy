<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Grapheme tiles</title>
<style>
  :root {
    color-scheme: light dark;
    --page: #e8e8e3;
    --hint: #55554f;
    --paper: #ffffff;
    --frame: #2a2a3a;
    --label: #77777f;
    --tile: #f4df3b;
    --edge: #1f1f1f;
    --ink: #1c1c1c;
    --red: #e3262e;
    --target: #0b6fe8;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --page: #1b1b19;
      --hint: #a9a9a0;
    }
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    padding: 16px 12px 32px;
    background: var(--page);
    font-family: "Sassoon Primary", "Andika", "Century Gothic", "Trebuchet MS", system-ui, sans-serif;
  }

  .hint {
    max-width: 960px;
    margin: 0 auto 12px;
    color: var(--hint);
    font-size: 15px;
    line-height: 1.45;
  }

  /* The board is laid out at a fixed 960px "design" width and scaled to fit the screen. */
  #wrap { position: relative; margin: 0 auto; }

  #board {
    position: absolute;
    left: 0;
    top: 0;
    width: 960px;
    padding: 24px;
    background: var(--paper);
    transform-origin: 0 0;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ---------- tile grid (the supply) ---------- */
  #stock {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 12px 10px;
  }
  #stock .tile.wide { grid-column: span 3; }
  #stock .tile { cursor: grab; }

  /* ---------- work areas ---------- */
  .box {
    position: relative;
    border: 1.5px solid var(--frame);
    padding: 10px 14px;
    color: var(--label);
    font-size: 22px;
  }
  .box.needed { margin-top: 28px; height: 170px; }
  .box.words  { margin-top: 24px; height: 120px; }

  #clear {
    position: absolute;
    right: 10px;
    top: 8px;
    font: inherit;
    font-size: 16px;
    color: var(--ink);
    background: #f1f1ee;
    border: 1.5px solid var(--frame);
    border-radius: 4px;
    padding: 3px 12px;
    cursor: pointer;
  }
  #clear:hover { background: #e4e4df; }
  #clear:focus-visible { outline: 3px solid var(--target); outline-offset: 2px; }

  /* ---------- tiles ---------- */
  .tile {
    position: relative;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 2px;
    background: var(--tile);
    border-radius: 3px;
    box-shadow: -1.5px 1.5px 0 var(--edge);
    font-size: 34px;
    line-height: 1;
    color: var(--ink);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .tile.red { color: var(--red); }
  .tile.long { font-size: 29px; }
  .tile.split {
    justify-content: space-between;
    padding: 0 20% 2px 15%;
  }

  #layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .tile.placed {
    position: absolute;
    pointer-events: auto;
    cursor: grab;
    transition: box-shadow 0.12s, transform 0.12s, opacity 0.12s;
  }

  /* joined tiles: square the seam and draw a thin divider */
  .tile.joined-left  { border-top-left-radius: 0;  border-bottom-left-radius: 0; }
  .tile.joined-right { border-top-right-radius: 0; border-bottom-right-radius: 0; }
  .tile.joined-left::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 1.5px;
    background: rgba(0, 0, 0, 0.4);
  }

  .tile.dragging {
    cursor: grabbing;
    transition: none;
    transform: translateY(-3px);
    box-shadow: -2px 3px 0 var(--edge), 0 12px 16px rgba(0, 0, 0, 0.28);
  }
  .tile.discard { opacity: 0.45; }
  .tile.snap-target {
    box-shadow: -1.5px 1.5px 0 var(--edge), 0 0 0 4px var(--target);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile.placed { transition: none; }
  }
</style>
</head>
<body>

<p class="hint">Drag a tile onto the mat. Drop it edge to edge against another tile to join them. Drag a tile out of a word to pull it apart, and drop tiles back on the grid to put them away.</p>

<div id="wrap">
  <div id="board">
    <div id="stock"></div>
    <div class="box needed">Put graphemes needed here.</div>
    <div class="box words">
      Make words here.
      <button id="clear" type="button">Clear mat</button>
    </div>
    <div id="layer"></div>
  </div>
</div>

<script>
(() => {
  // "!" = red (vowel) tile, "~" = blank tile, "_" = split digraph (a_e)
  const ROWS = [
    ['b','c','d','f','g','h','j','k','l'],
    ['m','n','p','qu','r','s','t','v','w'],
    ['x','y','z','ff','gg','ll','ss','tt','zz'],
    ['ch','sh','th','wh','ph','ck','ng','gn','kn'],
    ['tch','mb','dge','wr','se','ve','~','!aw','!au'],
    ['!a','!a_e','!ai','!ay','!eigh','!ough','!ar'],
    ['!e','!e_e','!ee','!ea','!ey','!oy','!er'],
    ['!i','!i_e','!ie','!igh','!y','!oi','!ir'],
    ['!o','!o_e','!oe','!oa','!ow','!ou','!or'],
    ['!u','!u_e','!ue','!ui','!ew','!oo','!ur']
  ];

  const DW = 960;        // design width of the board
  const TH = 54;         // tile height
  const SNAP = 30;       // snap distance in design px
  const DRAG_START = 5;  // pointer travel before a drag begins

  const page = document.body;
  const wrap = document.getElementById('wrap');
  const board = document.getElementById('board');
  const stock = document.getElementById('stock');
  const layer = document.getElementById('layer');
  const clearBtn = document.getElementById('clear');

  let scale = 1;
  const tiles = new Set();
  let drag = null;
  let snapEl = null;

  /* ---------- building tiles ---------- */
  function parse(raw) {
    const red = raw.startsWith('!');
    const text = raw.replace(/^[!~]/, '');
    return { red, text, split: text.includes('_') };
  }

  function buildEl(raw) {
    const s = parse(raw);
    const el = document.createElement('div');
    el.className = 'tile' + (s.red ? ' red' : '');
    if (s.split) {
      el.classList.add('split', 'wide');
      const [a, b] = s.text.split('_');
      el.innerHTML = '<span>' + a + '</span><span>' + b + '</span>';
    } else {
      el.textContent = s.text;
      if (s.text.length >= 4) el.classList.add('long');
    }
    el.dataset.raw = raw;
    return el;
  }

  ROWS.forEach(row => row.forEach(raw => {
    const el = buildEl(raw);
    el.classList.add('stock-tile');
    stock.appendChild(el);
  }));

  /* ---------- scaling ---------- */
  function fit() {
    const avail = page.clientWidth - 24;
    scale = Math.min(avail / DW, 1.25);
    board.style.transform = 'scale(' + scale + ')';
    wrap.style.width = DW * scale + 'px';
    wrap.style.height = board.offsetHeight * scale + 'px';
  }
  window.addEventListener('resize', fit);
  fit();

  const local = (cx, cy) => {
    const r = board.getBoundingClientRect();
    return { x: (cx - r.left) / scale, y: (cy - r.top) / scale };
  };
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

  /* ---------- placed tiles ---------- */
  function addTile(raw, x, y, w) {
    const el = buildEl(raw);
    el.classList.add('placed');
    el.style.width = w + 'px';
    const t = { raw, x, y, w, el, prev: null, next: null };
    el._tile = t;
    layer.appendChild(el);
    tiles.add(t);
    place(t);
    return t;
  }
  function place(t) {
    t.el.style.left = t.x + 'px';
    t.el.style.top = t.y + 'px';
  }
  function joints(t) {
    t.el.classList.toggle('joined-left', !!t.prev);
    t.el.classList.toggle('joined-right', !!t.next);
  }
  function chainFrom(t) {
    const out = [];
    for (let c = t; c; c = c.next) out.push(c);
    return out;
  }
  function removeTile(t) {
    if (t.prev) { t.prev.next = null; joints(t.prev); }
    if (t.next) { t.next.prev = null; joints(t.next); }
    t.el.remove();
    tiles.delete(t);
  }

  /* ---------- snapping ---------- */
  function findSnap(group) {
    const head = group[0];
    const tail = group[group.length - 1];
    const tailRight = tail.x + tail.w;
    const W = tailRight - head.x;
    let best = null;

    const consider = (d, side, T, dx, dy) => {
      const nx = head.x + dx;
      if (nx < 0 || nx > DW - W) return;
      if (d < SNAP && (!best || d < best.d)) best = { d, side, T, dx, dy };
    };

    for (const T of tiles) {
      if (group.includes(T)) continue;
      if (!T.next) {   // group goes on the right end of T
        const d = Math.hypot(head.x - (T.x + T.w), head.y - T.y);
        consider(d, 'right', T, T.x + T.w - head.x, T.y - head.y);
      }
      if (!T.prev) {   // group goes on the left end of T
        const d = Math.hypot(tailRight - T.x, tail.y - T.y);
        consider(d, 'left', T, T.x - tailRight, T.y - tail.y);
      }
    }
    return best;
  }

  function applySnap(group, s) {
    const head = group[0];
    const tail = group[group.length - 1];
    group.forEach(g => { g.x += s.dx; g.y += s.dy; place(g); });
    if (s.side === 'right') { s.T.next = head; head.prev = s.T; }
    else { tail.next = s.T; s.T.prev = tail; }
    group.forEach(joints);
    joints(s.T);
  }

  function showSnap(s) {
    const el = s ? s.T.el : null;
    if (el === snapEl) return;
    if (snapEl) snapEl.classList.remove('snap-target');
    snapEl = el;
    if (snapEl) snapEl.classList.add('snap-target');
  }

  /* ---------- dragging ---------- */
  const overStock = (cx, cy) => {
    const r = stock.getBoundingClientRect();
    return cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom;
  };

  board.addEventListener('pointerdown', e => {
    if (e.button !== undefined && e.button !== 0) return;
    const el = e.target.closest('.tile');
    if (!el) return;
    e.preventDefault();
    drag = {
      pid: e.pointerId,
      sx: e.clientX,
      sy: e.clientY,
      moved: false,
      kind: el.classList.contains('stock-tile') ? 'stock' : 'placed',
      el,
      group: []
    };
  });

  function startDrag() {
    const r = board.getBoundingClientRect();
    if (drag.kind === 'stock') {
      const sr = drag.el.getBoundingClientRect();
      const t = addTile(drag.el.dataset.raw,
        (sr.left - r.left) / scale, (sr.top - r.top) / scale, sr.width / scale);
      drag.group = [t];
    } else {
      const t = drag.el._tile;
      if (t.prev) {            // pull this tile (and everything to its right) away
        const p = t.prev;
        p.next = null; t.prev = null;
        joints(p); joints(t);
      }
      drag.group = chainFrom(t);
    }
    const head = drag.group[0];
    const last = drag.group[drag.group.length - 1];
    const p0 = local(drag.sx, drag.sy);
    drag.offX = p0.x - head.x;
    drag.offY = p0.y - head.y;
    drag.rel = drag.group.map(g => ({ dx: g.x - head.x, dy: g.y - head.y }));
    drag.W = last.x + last.w - head.x;
    drag.group.forEach(g => {
      layer.appendChild(g.el);
      g.el.classList.add('dragging');
    });
    drag.moved = true;
  }

  window.addEventListener('pointermove', e => {
    if (!drag || e.pointerId !== drag.pid) return;
    if (!drag.moved) {
      if (Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy) < DRAG_START) return;
      startDrag();
    }
    const p = local(e.clientX, e.clientY);
    const hx = clamp(p.x - drag.offX, 0, DW - drag.W);
    const hy = clamp(p.y - drag.offY, 0, board.offsetHeight - TH);
    drag.group.forEach((g, i) => {
      g.x = hx + drag.rel[i].dx;
      g.y = hy + drag.rel[i].dy;
      place(g);
    });
    const discard = overStock(e.clientX, e.clientY);
    drag.group.forEach(g => g.el.classList.toggle('discard', discard));
    showSnap(discard ? null : findSnap(drag.group));
  });

  function endDrag(e, allowSnap) {
    if (!drag || e.pointerId !== drag.pid) return;
    const d = drag;
    drag = null;
    showSnap(null);
    if (!d.moved) return;
    d.group.forEach(g => g.el.classList.remove('dragging', 'discard'));
    if (overStock(e.clientX, e.clientY)) {
      d.group.forEach(removeTile);
      return;
    }
    if (allowSnap) {
      const s = findSnap(d.group);
      if (s) applySnap(d.group, s);
    }
  }
  window.addEventListener('pointerup', e => endDrag(e, true));
  window.addEventListener('pointercancel', e => endDrag(e, false));

  clearBtn.addEventListener('click', () => {
    tiles.forEach(t => t.el.remove());
    tiles.clear();
  });
})();
</script>
</body>
</html>
